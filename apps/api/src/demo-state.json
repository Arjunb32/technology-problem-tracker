  "revisions": [
    {
      "id": "demo-revision-0",
      "solutionId": "demo-solution-0",
      "number": 1,
      "title": "Disable power saving for the wireless adapter",
      "instructions": "Open Device Manager, find the wireless adapter, and open Properties. In Power Management, clear “Allow the computer to turn off this device to save power.” Restart and test sleep and wake again.",
      "reasoning": "This is an illustrative fix for demonstrating the testing workflow. Confirm applicability before making changes.",
      "supportedSetup": "Windows 11 24H2 · Intel AX210 · driver 23.80",
      "limitations": "Demonstration only; individual devices and software versions may behave differently.",
      "warnings": "Save your work and record current settings before changing them.",
      "createdAt": "2026-10-01T09:00:00.000Z"
    },
    {
      "id": "demo-revision-1",
      "solutionId": "demo-solution-1",
      "number": 1,
      "title": "Try a different USB port for your Bluetooth adapter",
      "instructions": "Move the Bluetooth adapter away from USB 3 devices using a short extension cable. Test audio with both devices connected.",
      "reasoning": "This is an illustrative fix for demonstrating the testing workflow. Confirm applicability before making changes.",
      "supportedSetup": "Windows 11 · Bluetooth 5.2 headset",
      "limitations": "Demonstration only; individual devices and software versions may behave differently.",
      "warnings": "Save your work and record current settings before changing them.",
      "createdAt": "2026-10-01T09:00:00.000Z"
    },
    {
      "id": "demo-revision-2",
      "solutionId": "demo-solution-2",
      "number": 1,
      "title": "Reconnect the resolver after switching networks",
      "instructions": "Check the active resolver configuration. Reconnect the affected network in NetworkManager, then confirm that DNS queries use the current network. Record the old settings before changing anything.",
      "reasoning": "This is an illustrative fix for demonstrating the testing workflow. Confirm applicability before making changes.",
      "supportedSetup": "Ubuntu 24.04 · NetworkManager",
      "limitations": "Demonstration only; individual devices and software versions may behave differently.",
